# Results: Study 2 - Post-Discharge PGHD Cohort

## Table 1. Sample Characteristics

```{r table1, echo=FALSE}
# tbl1_data_m2 is already loaded from load-precomputed chunk
#  Save Table 1 underlying data to xlsx 
writexl::write_xlsx(as.data.frame(tbl1_data_m2),
                    file.path(out_data, "s2_Table1_cohort_characteristics.xlsx"))

# Determine which py2_ columns are actually present
py2_cols <- names(tbl1_data_m2)[str_detect(names(tbl1_data_m2), "^py2_")]

#  Explicit variable groups (controls ordering and group headers) 
grp_pghd <- character(0)  # No pre-discharge PGHD aggregate in Study 2

grp_can <- intersect(
  c("Age", "Gender", "Race", "Ethnicity", "MaritalStatus", "GISURH", "PriorityGroup", "season",
    py2_cols, "cci_score",
    "py_ed", "py_urgent", "py_appt_no_show",
    "bmi_fitted_mean", "map_fitted_mean", "recent_pulse",
    "bun_value_mean", "albumin_value_mean", "leuk_value_mean",
    "mst_status", "current_smoker", "never_smoker"),
  names(tbl1_data_m2))

grp_events <- intersect(
  c("had_event", "had_event_30d", "days_to_event", "first_event_type"),
  names(tbl1_data_m2))

tbl1_vars <- c(grp_pghd, grp_can, grp_events)

# Continuous py2_ variables - kept numeric, not coerced to factor
py2_continuous <- c("py2_mwi_score", "py2_IVC_los", "py2_IVC_n")

py2_label_map <- c(
  py2_acute_renal_failure      = "Acute renal failure (2yr)",
  py2_artificial_openings      = "Artificial opening / ostomy (2yr)",
  py2_chronic_pancreatitis     = "Chronic pancreatitis (2yr)",
  py2_chronic_ulcer_skin       = "Chronic skin ulcer (2yr)",
  py2_congestive_heart_failure = "Congestive heart failure (2yr)",
  py2_drug_alcohol_dependence  = "Substance use disorder (2yr)",
  py2_drug_alcohol_psychosis   = "Substance-induced psychosis (2yr)",
  py2_lung_severe_cancers      = "Lung / severe cancer (2yr)",
  py2_metastatic_cancer        = "Metastatic cancer (2yr)",
  py2_pregnancy                = "Pregnancy (2yr)",
  py2_heart_arrhythmias        = "Cardiac arrhythmia (2yr)",
  py2_financial_sdoh           = "Financial hardship / SDOH (2yr)",
  py2_housing_instability      = "Housing instability (2yr)",
  py2_nonspecific_psychosocial = "Nonspecific psychosocial problem (2yr)",
  py2_dialysis_access          = "Dialysis access procedure (2yr)",
  py2_dialysis_status          = "Dialysis status (2yr)",
  py2_mwi_score                = "Multimorbidity Weighted Index score (2yr)",
  py2_IVC_n                    = "Community care stays, count (among admitted, 2yr)",
  py2_IVC_los                  = "Community care, total LOS days (among admitted, 2yr)",
  py2_IVC                      = "Community care stays, any (2yr)",

  py2_inpat_any                = "Any inpatient admission (2yr)",
  py2_inpat_med_surg           = "Med/surgical admission (2yr)",
  py2_inpat_mental_health      = "Mental health admission (2yr)",
  py2_inpat_nursing_home       = "Nursing home admission (2yr)",
  py2_inpat_other              = "Other inpatient admission (2yr)"
)
base_label_map <- list(
  Age                      = "Age (years)",
  Gender                   = "Sex",
  Race                     = "Race",
  Ethnicity                = "Ethnicity",
  MaritalStatus            = "Marital status",
  GISURH                   = "Rural/Urban (GISURH)",
  PriorityGroup            = "VA Priority Group",
  season                   = "Season of discharge",
  py_ed                    = "Any ED visit (prior year)",
  py_urgent                = "Any urgent care (prior year)",
  py_appt_no_show          = "Appointment no-show (prior year)",
  bmi_fitted_mean          = "BMI (spline-fitted mean)",
  map_fitted_mean          = "MAP (spline-fitted mean, mmHg)",
  recent_pulse             = "Recent pulse (bpm)",
  bun_value_mean           = "BUN (mean, mg/dL)",
  albumin_value_mean       = "Albumin (mean, g/dL)",
  leuk_value_mean          = "Leukocytes (mean, 10^3/\u00b5L)",
  cci_score                = "Charlson Comorbidity Index (CCI) score",
  mst_status               = "Military sexual trauma",
  current_smoker           = "Current smoker",
  never_smoker             = "Never smoker",
  had_event                = "Had any composite event (follow-up)",
  had_event_30d            = "Had composite event within 30 days of discharge",
  days_to_event            = "Days from discharge to first event",
  first_event_type         = "First composite event type"
)
all_labels    <- c(as.list(py2_label_map), base_label_map)
present_labels <- all_labels[intersect(names(all_labels), tbl1_vars)]

# Mark reference groups & convert NA  "Unknown" for categorical display 
mark_ref <- function(x, ref_lv = NULL) {
  # Strip any prior "(ref)" tags so the function is idempotent across re-runs
  x_chr <- gsub(" \\(ref\\)$", "", as.character(x))
  x <- factor(x_chr)
  if (is.null(ref_lv)) ref_lv <- levels(x)[1]
  new_lv <- c(paste0(ref_lv, " (ref)"), setdiff(levels(x), c(ref_lv, "Unknown")), "Unknown")
  x_chr[is.na(x_chr)] <- "Unknown"
  x_chr[x_chr == ref_lv] <- paste0(ref_lv, " (ref)")
  factor(x_chr, levels = new_lv)
}
tbl1_data_m2 <- tbl1_data_m2 %>%
  mutate(
    Gender         = mark_ref(Gender),
    Race           = mark_ref(Race, "White"),
    Ethnicity      = mark_ref(Ethnicity, "Not Hispanic or Latino"),
    MaritalStatus  = mark_ref(MaritalStatus, "Married"),
    GISURH         = mark_ref(GISURH, "Urban"),
    PriorityGroup  = mark_ref(PriorityGroup, "Group 1"),
    mst_status     = mark_ref(mst_status),
    tobacco_status = mark_ref(tobacco_status)
  )

tbl_obj <- tbl1_data_m2 %>%
  select(index_event_type, all_of(tbl1_vars)) %>%
  tbl_summary(
    by      = index_event_type,
    missing = "ifany",
    statistic = list(
      all_continuous()  ~ "{mean} ({sd}); {median} ({p25}, {p75})",
      all_categorical() ~ "{n} ({p}%)"
    ),
    digits = list(all_continuous() ~ 1),
    label  = present_labels
  )

# Add visual section headers - requires gtsummary >= 2.0; falls back gracefully
tbl_obj <- tryCatch(
  tbl_obj %>%
    add_variable_group_header(
      list(
        "CAN-Score Analog Clinical Features"  = grp_can,
        "Event Variables"                     = grp_events
      )
    ),
  error = function(e) tbl_obj
)

tbl1_display <- tbl_obj %>%
  add_overall(last = FALSE) %>%
  add_p(pvalue_fun = ~style_pvalue(.x, digits = 2)) %>%
  bold_labels() %>%
  modify_caption(
    "**Table 1. Sample characteristics by index event type (ED vs. Inpatient).** Variables grouped as: (1) CAN-Score Analog Clinical Features, (2) Event Variables. Continuous: mean (SD); median (IQR); categorical: N (%). p-values from Kruskal-Wallis (continuous) or \u03c7\u00b2 (categorical) tests."
  )
tbl1_display
```

