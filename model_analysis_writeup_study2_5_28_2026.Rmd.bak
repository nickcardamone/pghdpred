```{r data-load-m2, include = FALSE, eval = FALSE}
# 
# STUDY 2 DATA PIPELINE  Load raw inputs and build post-discharge daily data
# 
data_dir        <- file.path(base_dir, "data", "input")
outcome_horizon <- 30L   # days for Y_30d label

#  Preflight check 
required_files_m2 <- c(
  file.path(data_dir, "index_event_prelim.parquet"),
  file.path(data_dir, "hcu_events_daily.parquet"),
  file.path(data_dir, "pghd_final_full.parquet"),
  file.path(data_dir, "cohort_full_demo.parquet"),
  file.path(data_dir, "patient_condition_flags_prior_m2.parquet"),
  file.path(data_dir, "final_vitals_features_with_splines_m2.parquet"),
  file.path(data_dir, "final_health_factors_tobacco_mst_m2.parquet"),
  file.path(data_dir, "hc_util_prior.parquet"))
missing_files_m2 <- Filter(Negate(file.exists), required_files_m2)
if (length(missing_files_m2) > 0L)
  stop("Missing upstream parquet file(s):\n  ", paste(missing_files_m2, collapse = "\n  "))

dir.create(out_output, recursive = TRUE, showWarnings = FALSE)
dir.create(out_data,   recursive = TRUE, showWarnings = FALSE)

#  Index events 
index_events_raw <- open_dataset(file.path(data_dir, "index_event_prelim.parquet")) %>%
  collect() %>%
  mutate(
    index_date           = as.Date(index_date),
    index_discharge_date = as.Date(index_discharge_date),
    discharge_date       = coalesce(index_discharge_date, index_date),
    index_event_type     = if_else(
      as.integer(coalesce(index_inpat, 0L)) == 1L, "Inpatient", "ED")
  )

n0_pts  <- n_distinct(index_events_raw$PatientICN)
n0_evts <- nrow(index_events_raw)

index_events <- index_events_raw %>%
  filter(discharge_date >= inception_cutoff_m2, discharge_date <= followup_cutoff)

n1_pts  <- n_distinct(index_events$PatientICN)
n1_evts <- nrow(index_events)
eligible_icns <- unique(index_events$PatientICN)

#  Static features cohort_static_m2 
demo       <- open_dataset(file.path(data_dir, "cohort_full_demo.parquet")) %>% collect()
cond_flags <- open_dataset(file.path(data_dir, "patient_condition_flags_prior_m2.parquet")) %>% collect()
vitals     <- open_dataset(file.path(data_dir, "final_vitals_features_with_splines_m2.parquet")) %>%
  select(PatientICN,
         bmi_fitted_mean, bmi_slope, bmi_fitted_last,
         map_fitted_mean, map_slope, map_fitted_last,
         sbp_value_mean, dbp_value_mean,
         spo2_value_mean, temp_value_mean, recent_pulse,
         bun_value_mean, bun_value_last,
         albumin_value_mean, albumin_value_last,
         leuk_value_mean, leuk_value_last) %>% collect()
health_fac <- open_dataset(file.path(data_dir, "final_health_factors_tobacco_mst_m2.parquet")) %>%
  select(PatientICN, tobacco_status, mst_status) %>% collect()
hc_util    <- open_dataset(file.path(data_dir, "hc_util_prior.parquet")) %>%
  distinct() %>% collect()

cohort_static_m2 <- demo %>%
  select(PatientICN, Age, Race, Gender, Ethnicity, MaritalStatus, Married,
         GISURH, PriorityGroup, dod) %>%
  left_join(cond_flags, by = "PatientICN") %>%
  left_join(hc_util,    by = "PatientICN") %>%
  left_join(vitals,     by = "PatientICN") %>%
  left_join(health_fac, by = "PatientICN")

write_parquet(cohort_static_m2, file.path(out_output, "cohort_static_m2.parquet"))

#  PGHD daily data 
pghd_raw <- open_dataset(file.path(data_dir, "pghd_final_full.parquet")) %>%
  filter(PatientICN %in% eligible_icns) %>%
  select(PatientICN, date,
         fit_das_exercise_steps, gar_das_exercise_steps, ah_das_exercise_steps,
         fit_das_exercise_m,     gar_das_exercise_m,     ah_das_exercise_m) %>%
  collect() %>%
  mutate(
    date             = as.Date(date),
    fit_garmin_steps = pmax_na(fit_das_exercise_steps, gar_das_exercise_steps),
    apple_steps      = ah_das_exercise_steps,
    fit_garmin_m     = pmax_na(fit_das_exercise_m,     gar_das_exercise_m),
    apple_m          = ah_das_exercise_m,
    daily_steps      = coalesce(fit_garmin_steps, apple_steps),
    daily_steps      = if_else(daily_steps == 0, NA_real_, daily_steps),
    daily_exercise_m = coalesce(fit_garmin_m, apple_m),
    daily_exercise_m = if_else(daily_exercise_m == 0, NA_real_, daily_exercise_m),
    has_upload       = as.integer(!is.na(daily_steps) | !is.na(daily_exercise_m))
  ) %>%
  select(PatientICN, date, daily_steps, daily_exercise_m, has_upload)

#  Outcome events 
dod_tbl    <- demo %>%
  select(PatientICN, dod) %>%
  mutate(dod = as.Date(dod)) %>%
  filter(!is.na(dod))

hcu_events <- open_dataset(file.path(data_dir, "hcu_events_daily.parquet")) %>%
  filter(PatientICN %in% eligible_icns) %>%
  collect() %>%
  mutate(
    date       = as.Date(date),
    event_flag = as.integer(
      coalesce(as.integer(ed), 0L) | coalesce(as.integer(inpat_any), 0L))
  ) %>%
  filter(event_flag == 1L) %>%
  select(PatientICN, date)

# Treat death as an outcome event
hcu_events <- bind_rows(
  hcu_events,
  dod_tbl %>% rename(date = dod)
) %>%
  distinct(PatientICN, date)

#  Build post-discharge daily data 
# Cross-join each index event with PGHD days in [1, max_pd_window] post-discharge
pd_events_tbl <- index_events %>%
  select(PatientICN, discharge_date, index_event_type)

pd_daily <- pd_events_tbl %>%
  inner_join(pghd_raw, by = "PatientICN", relationship = "many-to-many") %>%
  mutate(days_post_discharge = as.integer(date - discharge_date)) %>%
  filter(days_post_discharge >= 1L, days_post_discharge <= max_pd_window)

gc()

#  Step imputation (OLS: steps ~ exercise_m) 
set.seed(2026L)
imp_train_m2 <- pd_daily %>%
  filter(!is.na(daily_steps), !is.na(daily_exercise_m))
if (nrow(imp_train_m2) > 50000L)
  imp_train_m2 <- slice_sample(imp_train_m2, n = 50000L)

step_imp_m2 <- if (nrow(imp_train_m2) >= 50L)
  suppressWarnings(lm(daily_steps ~ daily_exercise_m, data = imp_train_m2)) else NULL
rm(imp_train_m2)

if (!is.null(step_imp_m2)) {
  miss_idx <- which(is.na(pd_daily$daily_steps) & !is.na(pd_daily$daily_exercise_m))
  if (length(miss_idx) > 0L)
    pd_daily$daily_steps[miss_idx] <- pmax(0, predict(step_imp_m2,
      newdata = data.frame(daily_exercise_m = pd_daily$daily_exercise_m[miss_idx])))
}
pd_daily$daily_steps_imp <- pd_daily$daily_steps

#  Compute rolling step features (within each patient-discharge episode) 
pd_dt  <- as.data.table(pd_daily)
by_ep  <- c("PatientICN", "discharge_date")
setorder(pd_dt, PatientICN, discharge_date, days_post_discharge)

pd_dt[, c("s7d_avg","s7d_days") := {
  r <- roll_avg_with_days(daily_steps_imp, 7L); list(r$avg, r$days)
}, by = by_ep]
pd_dt[, k_steps_7d_avg         := s7d_avg / 1000]
pd_dt[, k_steps_7d_miss_days   := as.integer(7L - fifelse(is.na(s7d_days), 0L, s7d_days))]
pd_dt[, k_steps_7d_sd          := roll_sd(daily_steps_imp, 7L) / 1000, by = by_ep]

pd_dt[, is_low_activity     := as.integer(!is.na(daily_steps_imp) & daily_steps_imp < 1000)]
pd_dt[, low_activity_days_7d := frollsum(is_low_activity, n = 7L, align = "right"), by = by_ep]
pd_dt[, low_activity_streak := {
  s <- integer(.N); cur <- 0L
  for (i in seq_len(.N)) {
    if (is.na(is_low_activity[i])) { s[i] <- NA_integer_; cur <- 0L
    } else if (is_low_activity[i] == 1L) { cur <- cur + 1L; s[i] <- cur
    } else { s[i] <- 0L; cur <- 0L }
  }; s
}, by = by_ep]

pd_dt[, c("s7d_avg","s7d_days","is_low_activity") := NULL]

pd_daily_feats <- as_tibble(pd_dt)
write_parquet(pd_daily_feats, file.path(out_output, "pd_daily_feats.parquet"))
rm(pd_dt, pd_daily, pghd_raw); gc()
```

```{r build-junctures-m2, include = FALSE, eval = FALSE}
# 
# STUDY 2 JUNCTURE PIPELINE  snapshots at Wk01--Wk04
# Outcomes labeled, static features joined, CONSORT + patient_summary saved
# 
pd_daily_feats   <- open_dataset(file.path(out_output, "pd_daily_feats.parquet")) %>% collect()
cohort_static_m2 <- open_dataset(file.path(out_output, "cohort_static_m2.parquet")) %>% collect()

if (!exists("index_events")) {
  index_events <- open_dataset(file.path(data_dir, "index_event_prelim.parquet")) %>%
    collect() %>%
    mutate(
      index_date           = as.Date(index_date),
      index_discharge_date = as.Date(index_discharge_date),
      discharge_date       = coalesce(index_discharge_date, index_date),
      index_event_type     = if_else(
        as.integer(coalesce(index_inpat, 0L)) == 1L, "Inpatient", "ED")
    ) %>%
    filter(discharge_date >= inception_cutoff_m2, discharge_date <= followup_cutoff)
}

juncture_days_vec <- c(Wk01 = 7L, Wk02 = 14L, Wk03 = 21L, Wk04 = 28L)

#  Take juncture snapshot: last valid step row at or before cutoff day 
junc_raw <- purrr::imap(juncture_days_vec, function(cutoff_day, junc_label) {
  pd_daily_feats %>%
    filter(days_post_discharge <= cutoff_day, !is.na(k_steps_7d_avg)) %>%
    group_by(PatientICN, discharge_date) %>%
    slice_max(days_post_discharge, n = 1L, with_ties = FALSE) %>%
    ungroup() %>%
    mutate(juncture = junc_label, juncture_date = discharge_date + cutoff_day)
}) %>% bind_rows()

#  Y_30d: event in (juncture_date, juncture_date + outcome_horizon] 
if (!exists("hcu_events")) {
  hcu_dts <- open_dataset(file.path(data_dir, "hcu_events_daily.parquet")) %>%
    filter(PatientICN %in% unique(index_events$PatientICN)) %>%
    collect() %>%
    mutate(date       = as.Date(date),
           event_flag = as.integer(
             coalesce(as.integer(ed), 0L) | coalesce(as.integer(inpat_any), 0L))) %>%
    filter(event_flag == 1L) %>% select(PatientICN, date)
  dod_dt  <- cohort_static_m2 %>%
    select(PatientICN, dod) %>% filter(!is.na(dod)) %>%
    mutate(date = as.Date(dod)) %>% select(PatientICN, date)
  hcu_events <- bind_rows(hcu_dts, dod_dt) %>% distinct(PatientICN, date)
  rm(hcu_dts, dod_dt)
}

first_event_after <- index_events %>%
  select(PatientICN, discharge_date) %>%
  left_join(hcu_events, by = "PatientICN", relationship = "many-to-many") %>%
  filter(as.Date(date) > discharge_date) %>%
  group_by(PatientICN, discharge_date) %>%
  summarise(first_event_date = min(date, na.rm = TRUE), .groups = "drop")

junc_labeled <- junc_raw %>%
  left_join(first_event_after, by = c("PatientICN", "discharge_date")) %>%
  mutate(
    days_to_first_event = as.integer(
      as.Date(first_event_date) - as.Date(juncture_date)),
    Y_30d = as.integer(
      !is.na(first_event_date) &
      days_to_first_event >= 1L &
      days_to_first_event <= outcome_horizon),
    Y = Y_30d
  )

#  Manual dummy encoding for static features 
add_dummies_m2 <- function(df) {
  df %>% mutate(
    gender_Female      = as.integer(!is.na(Gender) & toupper(Gender) == "FEMALE"),
    gender_Unknown     = as.integer(is.na(Gender) | !toupper(Gender) %in% c("MALE","FEMALE")),
    race_Black         = as.integer(!is.na(Race) & Race == "Black or African American"),
    race_AI_AN         = as.integer(!is.na(Race) & Race == "American Indian or Alaska Native"),
    race_Asian         = as.integer(!is.na(Race) & Race == "Asian"),
    race_PI            = as.integer(!is.na(Race) & Race == "Native Hawaiian or Other Pacific Islander"),
    race_Unknown       = as.integer(
      is.na(Race) | !Race %in% c("White","Black or African American",
        "American Indian or Alaska Native","Asian",
        "Native Hawaiian or Other Pacific Islander")),
    eth_Hispanic       = as.integer(!is.na(Ethnicity) & Ethnicity == "Hispanic or Latino"),
    eth_Unknown        = as.integer(
      is.na(Ethnicity) | !Ethnicity %in% c("Hispanic or Latino","Not Hispanic or Latino")),
    marital_Divorced   = as.integer(!is.na(MaritalStatus) & toupper(MaritalStatus) == "DIVORCED"),
    marital_Never      = as.integer(!is.na(MaritalStatus) &
                           toupper(MaritalStatus) %in% c("NEVER MARRIED","SINGLE")),
    marital_Widowed    = as.integer(!is.na(MaritalStatus) & toupper(MaritalStatus) == "WIDOWED"),
    marital_Separated  = as.integer(!is.na(MaritalStatus) & toupper(MaritalStatus) == "SEPARATED"),
    marital_Unknown    = as.integer(
      is.na(MaritalStatus) |
      !toupper(MaritalStatus) %in% c("MARRIED","DIVORCED","NEVER MARRIED",
                                     "SINGLE","WIDOWED","SEPARATED")),
    gisurh_Rural       = as.integer(!is.na(GISURH) & toupper(GISURH) == "R"),
    gisurh_HighlyRural = as.integer(!is.na(GISURH) & toupper(GISURH) == "H"),
    gisurh_Insular     = as.integer(!is.na(GISURH) & toupper(GISURH) == "I"),
    gisurh_Unknown     = as.integer(
      is.na(GISURH) | !toupper(GISURH) %in% c("U","R","H","I")),
    .pg_num = suppressWarnings(
      as.integer(str_extract(as.character(PriorityGroup), "[0-9]+"))),
    pg_G2              = as.integer(!is.na(.pg_num) & .pg_num == 2L),
    pg_G3              = as.integer(!is.na(.pg_num) & .pg_num == 3L),
    pg_G4              = as.integer(!is.na(.pg_num) & .pg_num == 4L),
    pg_G5              = as.integer(!is.na(.pg_num) & .pg_num == 5L),
    pg_G6              = as.integer(!is.na(.pg_num) & .pg_num == 6L),
    pg_G7              = as.integer(!is.na(.pg_num) & .pg_num == 7L),
    pg_G8              = as.integer(!is.na(.pg_num) & .pg_num == 8L),
    pg_Unknown         = as.integer(is.na(.pg_num) | !.pg_num %in% 1:8),
    mst_Yes            = as.integer(toupper(as.character(mst_status)) == "YES"),
    current_smoker     = as.integer(tolower(as.character(tobacco_status)) == "current smoker"),
    never_smoker       = as.integer(tolower(as.character(tobacco_status)) == "never smoker"),
    index_event_type_Inpatient = as.integer(index_event_type == "Inpatient")
  ) %>% select(-.pg_num)
}

# Static columns available in cohort_static_m2
static_join_cols <- intersect(
  c("PatientICN","Age","Race","Gender","Ethnicity","MaritalStatus","Married",
    "GISURH","PriorityGroup","dod",
    names(cond_flags)[names(cond_flags) != "PatientICN"],
    names(hc_util)[names(hc_util) != "PatientICN"],
    names(vitals)[names(vitals) != "PatientICN"],
    names(health_fac)[names(health_fac) != "PatientICN"]),
  names(cohort_static_m2))

junc_full <- junc_labeled %>%
  left_join(cohort_static_m2 %>% select(all_of(static_join_cols)), by = "PatientICN") %>%
  add_dummies_m2()

junc_all <- junc_full
junc_ed  <- junc_full %>% filter(index_event_type == "ED")
junc_inp <- junc_full %>% filter(index_event_type == "Inpatient")

write_parquet(junc_all, file.path(out_output, "junc_all.parquet"))
write_parquet(junc_ed,  file.path(out_output, "junc_ed.parquet"))
write_parquet(junc_inp, file.path(out_output, "junc_inp.parquet"))

#  CONSORT counts 
n2_pts     <- n_distinct(pd_daily_feats$PatientICN[pd_daily_feats$has_upload == 1L])
n3_pts     <- n_distinct(junc_all$PatientICN[junc_all$juncture == "Wk01"])
n3_pts_ed  <- n_distinct(junc_ed$PatientICN[junc_ed$juncture  == "Wk01"])
n3_pts_inp <- n_distinct(junc_inp$PatientICN[junc_inp$juncture == "Wk01"])

tibble(n0_pts   = n0_pts,   n0_evts = n0_evts,
       n1_pts   = n1_pts,   n1_evts = n1_evts,
       n2_pts   = n2_pts,
       n3_pts   = n3_pts,
       n3_pts_ed  = n3_pts_ed,
       n3_pts_inp = n3_pts_inp) %>%
  write_parquet(file.path(out_output, "consort_counts_m2.parquet"))

#  Patient summary (for Figure 2 KM and Table 1) 
dod_vec <- setNames(as.Date(cohort_static_m2$dod), cohort_static_m2$PatientICN)
patient_summary_m2 <- index_events %>%
  left_join(first_event_after, by = c("PatientICN", "discharge_date")) %>%
  mutate(
    obs_end            = discharge_date + max_pd_window,
    days_to_event      = as.integer(as.Date(first_event_date) - discharge_date),
    had_event_30d      = as.integer(!is.na(days_to_event) & days_to_event <= outcome_horizon),
    first_event_type   = case_when(
      !is.na(first_event_date) &
        as.Date(first_event_date) == dod_vec[as.character(PatientICN)] ~ "Death",
      index_event_type == "Inpatient" & !is.na(first_event_date)       ~ "Inpatient Readmission",
      index_event_type == "ED"        & !is.na(first_event_date)       ~ "ED Return",
      is.na(first_event_date)                                           ~ "No Event",
      TRUE                                                               ~ "Event")
  ) %>%
  left_join(cohort_static_m2 %>% select(-dod), by = "PatientICN")

write_parquet(patient_summary_m2, file.path(out_output, "patient_summary_m2.parquet"))

#  Table 1 data 
tbl1_data_m2 <- patient_summary_m2 %>%
  mutate(
    Gender           = factor(Gender),
    Race             = factor(Race),
    Ethnicity        = factor(Ethnicity),
    MaritalStatus    = factor(MaritalStatus),
    GISURH           = factor(GISURH),
    PriorityGroup    = factor(PriorityGroup),
    mst_status       = factor(mst_status),
    tobacco_status   = factor(tobacco_status),
    index_event_type = factor(index_event_type, levels = c("ED","Inpatient")),
    first_event_type = factor(first_event_type,
      levels = c("Death","Inpatient Readmission","ED Return","No Event")),
    had_event        = as.integer(first_event_type != "No Event")
  )

write_parquet(tbl1_data_m2, file.path(out_output, "tbl1_data_m2.parquet"))

#  Inline parameters 
tibble(
  data_start_date       = format(inception_cutoff_m2, "%B %d, %Y"),
  data_end_date         = format(data_end_raw,        "%B %d, %Y"),
  followup_cutoff_label = format(followup_cutoff,     "%B %d, %Y"),
  max_pd_window         = as.integer(max_pd_window),
  outcome_horizon       = as.integer(outcome_horizon)
) %>% write_parquet(file.path(out_output, "inline_params_m2.parquet"))
