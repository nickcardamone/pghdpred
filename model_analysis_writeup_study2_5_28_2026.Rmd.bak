## Figure 2. Time to First Composite Event

```{r fig2-survival, echo=FALSE, fig.height=4.5, fig.cap="Figure 2. Kaplan-Meier survival curves for time from discharge to first composite post-discharge event (ED return, inpatient readmission, or death), stratified by index event type (ED vs. Inpatient). Tick marks indicate censored observations. Shaded bands represent 95% pointwise confidence intervals."}
if (!requireNamespace("survival", quietly = TRUE))
  try(install.packages("survival", repos = "https://cloud.r-project.org", quiet = TRUE), silent = TRUE)
library(survival)

km_data_m2 <- patient_summary_m2 %>%
  mutate(
    surv_time  = pmax(
      if_else(!is.na(first_event_date),
              as.numeric(difftime(first_event_date, discharge_date, units = "days")),
              pmin(as.numeric(difftime(obs_end, discharge_date, units = "days")),
                   as.numeric(max_pd_window))),
      0),
    event_flag = as.integer(!is.na(first_event_date)),
    index_event_type = factor(index_event_type, levels = c("ED", "Inpatient"))
  ) %>%
  filter(!is.na(surv_time), surv_time >= 0, !is.na(index_event_type))

km_fit_m2 <- survfit(Surv(surv_time, event_flag) ~ index_event_type, data = km_data_m2)

km_df_m2 <- data.frame(
  time    = km_fit_m2$time,
  surv    = km_fit_m2$surv,
  lower   = km_fit_m2$lower,
  upper   = km_fit_m2$upper,
  n.cens  = km_fit_m2$n.censor,
  strata  = rep(names(km_fit_m2$strata), km_fit_m2$strata)
) %>%
  mutate(Cohort = str_remove(strata, "index_event_type="))

n_events_m2 <- sum(km_data_m2$event_flag)
n_total_m2  <- nrow(km_data_m2)

ggplot(km_df_m2 %>% filter(time <= max_pd_window), aes(x = time, y = surv, color = Cohort)) +
  geom_ribbon(aes(ymin = lower, ymax = upper, fill = Cohort), alpha = 0.12, color = NA) +
  geom_step(linewidth = 0.7) +
  geom_point(data = km_df_m2 %>% filter(n.cens > 0, time <= max_pd_window),
             aes(x = time, y = surv), shape = 3, size = 1.0, alpha = 0.5) +
  scale_color_manual(values = c("ED" = "#d73027", "Inpatient" = "#4575b4"), name = "Index event") +
  scale_fill_manual( values = c("ED" = "#d73027", "Inpatient" = "#4575b4"), name = "Index event") +
  scale_y_continuous(labels = scales::percent_format(accuracy = 1),
                     limits = c(0.5, 1), expand = c(0, 0)) +
  scale_x_continuous(breaks = seq(0, max_pd_window, by = 30), expand = c(0.01, 0)) +
  labs(x = "Days from discharge",
       y = "Proportion event-free",
       title = NULL) +
  theme_science(base_size = 9) +
  theme(legend.position  = "right",
        legend.text      = element_text(size = 8),
        legend.title     = element_text(size = 8),
        panel.grid.major.y = element_line(colour = "grey92", linewidth = 0.3)) -> p_km_m2

ggsave(file.path(out_figures, "Figure_2_KM_postdischarge.png"),
       plot = p_km_m2, width = 9, height = 4.5, dpi = 300, bg = "white")
p_km_m2
```

