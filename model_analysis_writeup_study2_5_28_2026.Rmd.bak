### Sensitivity Analyses

```{r sensitivity-results, echo=FALSE, results='asis'}
# Sensitivity: stratified test-set performance by weekly data quality (30-day horizon)
if (!exists("sa_summaries_m2") || nrow(sa_summaries_m2) == 0) {
  cat("*Sensitivity results not available.*")
} else {
  sa_30d <- sa_summaries_m2 %>%
    filter(horizon == 30L) %>%
    mutate(
      feature_label = recode(feature_mode, !!!feat_labels),
      algo          = dplyr::recode(model_type, xgboost = "XGBoost", logistic = "Logistic")
    ) %>%
    select(feature_label, algo, stratum, n_test, events, auc, pr_auc, bss) %>%
    arrange(algo, feature_label, stratum)

  sa_30d %>%
    mutate(
      .grp = dplyr::case_when(
        algo == "Logistic" ~ "Logistic regression",
        algo == "XGBoost"  ~ "XGBoost",
        .default           = NA_character_
      )
    ) %>%
    select(.grp, feature_label, stratum, n_test, events, auc, pr_auc, bss) %>%
    gt(groupname_col = ".grp") %>%
    cols_label(
      feature_label = "Feature set",
      stratum       = "Data quality",
      n_test        = "Test N",
      events        = "Events",
      auc           = "AUC",
      pr_auc        = "PR-AUC",
      bss           = "BSS"
    ) %>%
    fmt_integer(columns = c(n_test, events)) %>%
    fmt_number(columns  = c(auc, pr_auc, bss), decimals = 4) %>%
    cols_width(feature_label ~ px(192)) %>%
    tab_header(title = html(paste0(
      "Table S1. Sensitivity Analysis: Test-set performance stratified by data quality ",
      "(30-day horizon, Wk04 snapshot). ",
      "'clean': 0-3 missing days per week. ",
      "'sparse': 4-6 missing days per week. ",
      "No model refit - post-hoc stratification of primary model predictions."
    ))) %>%
    tab_options(table.font.size = px(11), table.width = "auto") %>%
    print()
}
