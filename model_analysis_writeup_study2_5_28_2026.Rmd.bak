## Table 2. Predictive Model Performance

```{r table2, echo=FALSE}
# Table 2: model performance by feature set and algorithm, horizons as columns.
if (!exists("m2_perf_wide") || nrow(m2_perf_wide) == 0) {
  cat("*m2_perf_wide not available - re-run the model-fitting and load-precomputed chunks.*")
} else {
  # Null-model reference rows
  null_row_14 <- m2_summaries %>%
    filter(horizon == 14L) %>%
    slice(1) %>%
    transmute(
      feature_label = "Null (event rate)",
      algo          = "--",
      auc_14d       = 0.500,
      pr_auc_14d    = round(events_test / n_test, 4),
      bss_14d       = 0.000,
      cal_slope_pre_platt_14d  = NA_real_,
      cal_slope_post_platt_14d = NA_real_,
      n_test_14d    = n_test,
      events_test_14d = events_test
    )
  null_row_30 <- m2_summaries %>%
    filter(horizon == 30L) %>%
    slice(1) %>%
    transmute(
      feature_label = "Null (event rate)",
      algo          = "--",
      auc_30d       = 0.500,
      pr_auc_30d    = round(events_test / n_test, 4),
      bss_30d       = 0.000,
      cal_slope_pre_platt_30d  = NA_real_,
      cal_slope_post_platt_30d = NA_real_,
      n_test_30d    = n_test,
      events_test_30d = events_test
    )
  null_row <- full_join(null_row_14, null_row_30, by = c("feature_label","algo"))

  tbl2_data <- bind_rows(null_row, m2_perf_wide) %>%
    mutate(.grp = if_else(algo == "--", "Reference", algo))

  tbl2_gt <- tbl2_data %>%
    select(-.grp, .grp) %>%
    {
      tmp <- (.)
      tmp$.grp <- tmp$algo
      select(tmp, -algo, feature_label,
             auc_14d, pr_auc_14d, bss_14d,
             cal_slope_pre_platt_14d, cal_slope_post_platt_14d,
             n_test_14d, events_test_14d,
             auc_30d, pr_auc_30d, bss_30d,
             cal_slope_pre_platt_30d, cal_slope_post_platt_30d,
             n_test_30d, events_test_30d,
             .grp)
    } %>%
    gt(groupname_col = ".grp") %>%
    cols_label(
      feature_label             = "Feature set",
      auc_14d                   = "AUC",
      pr_auc_14d                = "PR-AUC",
      bss_14d                   = "BSS",
      cal_slope_pre_platt_14d   = "Cal. (pre)",
      cal_slope_post_platt_14d  = "Cal. (post)",
      n_test_14d                = "N",
      events_test_14d           = "Events",
      auc_30d                   = "AUC",
      pr_auc_30d                = "PR-AUC",
      bss_30d                   = "BSS",
      cal_slope_pre_platt_30d   = "Cal. (pre)",
      cal_slope_post_platt_30d  = "Cal. (post)",
      n_test_30d                = "N",
      events_test_30d           = "Events"
    ) %>%
    tab_spanner(label = "14-day horizon",
      columns = any_of(c("auc_14d","pr_auc_14d","bss_14d",
                          "cal_slope_pre_platt_14d","cal_slope_post_platt_14d",
                          "n_test_14d","events_test_14d"))) %>%
    tab_spanner(label = "30-day horizon",
      columns = any_of(c("auc_30d","pr_auc_30d","bss_30d",
                          "cal_slope_pre_platt_30d","cal_slope_post_platt_30d",
                          "n_test_30d","events_test_30d"))) %>%
    sub_missing(missing_text = "--") %>%
    fmt_number(columns = matches("^(auc|pr_auc|bss|cal_slope)"), decimals = 3) %>%
    fmt_integer(columns = matches("^(n_test|events_test)")) %>%
    tab_header(
      title = "Table 2. Model performance on 30% hold-out test set.",
      subtitle = paste0("Wk04 post-discharge snapshot. ",
                        "BSS = Brier Skill Score (0 = null, 1 = perfect); ",
                        "Cal. = post-Platt calibration slope (target 1.0).")) %>%
    tab_source_note(source_note = html(paste0(
      "<b>Note.</b> AUC = ROC-AUC; PR-AUC = precision-recall AUC; ",
      "BSS = Brier Skill Score; Cal. (pre/post) = calibration slope before/after ",
      "Platt scaling (target 1.0); N = test observations; Events = events in test set."
    ))) %>%
    tab_options(table.font.size = px(11), table.width = "auto")
  print(tbl2_gt)
}
```

