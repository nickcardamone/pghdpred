  cal_tbl_data %>%
    mutate(
      feature_label  = recode(feature_mode, !!!feat_labels),
      algo           = str_to_title(model_type),
      juncture_label = juncture
    ) %>%
    select(
      juncture_label, feature_label, algo,
      prob_bin, n, n_events, mean_predicted, observed_rate
    ) %>%
    downloadthis::download_this(
      output_name      = "Table3_calibration",
      output_extension = ".xlsx",
      button_label     = "Download Table 3 data (xlsx)",
      button_type      = "default",
      class            = "btn-sm"
    )
}
