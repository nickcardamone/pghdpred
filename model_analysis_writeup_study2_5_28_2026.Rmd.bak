```{r train-test-m2, eval = FALSE}
# 
# TRAIN / TEST SPLIT patient-level 70/30, shared across all cohorts/junctures
# 
junc_all <- open_dataset(file.path(out_output, "junc_all.parquet")) %>% collect()

set.seed(2026L)
all_pts_m2   <- unique(junc_all$PatientICN)
train_pts_m2 <- sample(all_pts_m2, floor(0.7 * length(all_pts_m2)))
test_pts_m2  <- setdiff(all_pts_m2, train_pts_m2)

write_parquet(tibble(PatientICN = train_pts_m2), file.path(out_output, "train_pts_m2.parquet"))
write_parquet(tibble(PatientICN = test_pts_m2),  file.path(out_output, "test_pts_m2.parquet"))

#  Feature column sets 
step_cols_m2 <- c(
  "k_steps_7d_avg","k_steps_7d_sd","k_steps_7d_miss_days",
  "low_activity_days_7d","low_activity_streak"
)

static_cols_m2_base <- c(
  "Age",
  "gender_Female","gender_Unknown",
  "race_Black","race_AI_AN","race_Asian","race_PI","race_Unknown",
  "eth_Hispanic","eth_Unknown",
  "marital_Divorced","marital_Never","marital_Widowed","marital_Separated","marital_Unknown",
  "gisurh_Rural","gisurh_HighlyRural","gisurh_Insular","gisurh_Unknown",
  "pg_G2","pg_G3","pg_G4","pg_G5","pg_G6","pg_G7","pg_G8","pg_Unknown",
  "cci_score",
  "py2_acute_renal_failure","py2_congestive_heart_failure","py2_drug_alcohol_dependence",
  "py2_lung_severe_cancers","py2_metastatic_cancer","py2_heart_arrhythmias",
  "py2_dialysis_status","py2_inpat_any","py2_inpat_med_surg","py2_inpat_mental_health",
  "py_ed","py_urgent",
  "bmi_fitted_mean","map_fitted_mean","recent_pulse",
  "bun_value_mean","albumin_value_mean","leuk_value_mean",
  "mst_Yes","current_smoker","never_smoker")

static_cols_m2_all    <- c(static_cols_m2_base, "index_event_type_Inpatient")
static_cols_by_cohort <- list(
  All       = static_cols_m2_all,
  ED        = static_cols_m2_base,
  Inpatient = static_cols_m2_base)

#  Missingness table (across all junctures "” row-level and person-level)
keep_check <- intersect(c(step_cols_m2, static_cols_m2_all), names(junc_all))

miss_tbl_m2 <- {
  feat_data <- junc_all %>% select(PatientICN, all_of(keep_check))
  feat_cols  <- keep_check

  junc_miss <- feat_data %>%
    select(all_of(feat_cols)) %>%
    summarise(across(everything(), ~ mean(is.na(.)))) %>%
    pivot_longer(everything(), names_to = "Feature", values_to = "pct_missing_week")

  person_miss <- feat_data %>%
    group_by(PatientICN) %>%
    summarise(across(all_of(feat_cols), ~ any(is.na(.))), .groups = "drop") %>%
    select(all_of(feat_cols)) %>%
    summarise(across(everything(), ~ mean(.))) %>%
    pivot_longer(everything(), names_to = "Feature", values_to = "pct_missing_person")

  left_join(junc_miss, person_miss, by = "Feature") %>%
    mutate(
      pct_missing_week   = round(pct_missing_week   * 100, 1),
      pct_missing_person = round(pct_missing_person * 100, 1)
    ) %>%
    filter(pct_missing_week > 0) %>%
    arrange(desc(pct_missing_week))
}

gc()
write_parquet(miss_tbl_m2, file.path(out_output, "miss_tbl_m2.parquet"))
```


```{r missingness-table}
miss_tbl <- arrow::read_parquet(file.path(out_output, "miss_tbl_m2.parquet"),
                                mmap = FALSE) %>%
  mutate(
    label    = coalesce(feat_display_names[Feature], Feature),
    category = classify_feature(Feature)
  ) %>%
  arrange(category, desc(pct_missing_week)) %>%
  select(category, label, pct_missing_week, pct_missing_person) %>%
  mutate(across(where(is.character), ~ iconv(., from = "", to = "UTF-8", sub = "byte")))

kbl_miss <- miss_tbl %>%
  gt(groupname_col = "category") %>%
  cols_label(
    label              = "Feature",
    pct_missing_week   = "Junctures Missing (%)",
    pct_missing_person = "Patients Missing (%)"
  ) %>%
  tab_header(title = html(paste0(
    "Table S1. Missingness rates before imputation. ",
    "\u2018Junctures Missing\u2019: % of juncture rows (across Wk01\u2013Wk04) with a missing value. ",
    "\u2018Patients Missing\u2019: % of patients with \u22651 missing juncture for that feature."
  ))) %>%
  cols_align(align = "left",  columns = label) %>%
  cols_align(align = "right", columns = c(pct_missing_week, pct_missing_person)) %>%
  cols_width(label ~ px(350)) %>%
  tab_options(
    table.font.size       = px(12),
    table.width           = "auto",
    row_group.font.weight = "bold"
  )

kbl_miss
