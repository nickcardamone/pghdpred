## Figure 3. Step Trajectories Before First Event

```{r fig-trajectory-m2, echo=FALSE, fig.height=6, fig.cap="Figure 3. Mean daily step count (+/- 1 SE) in the first 90 days post-discharge, by 30-day outcome group (event vs. no event) and index event type. Smoothed using a 7-day rolling mean for display. n shown per group at day 7."}
# pd_daily_labeled.parquet is not pre-computed; build on-the-fly from
# pd_daily_feats (daily PGHD) joined with outcome labels from patient_summary_m2
pd_labeled_disp <- arrow::open_dataset(
  file.path(out_output, "pd_daily_feats.parquet")) %>%
  collect() %>%
  mutate(
    date           = as.Date(date),
    discharge_date = as.Date(discharge_date)
  ) %>%
  filter(discharge_date >= inception_cutoff_m2,
         days_post_discharge >= 1,
         days_post_discharge <= 90) %>%
  left_join(
    patient_summary_m2 %>%
      select(PatientICN, discharge_date, first_event_date, index_event_type),
    by = c("PatientICN", "discharge_date")
  ) %>%
  mutate(
    days_to_event    = as.numeric(difftime(first_event_date, discharge_date, units = "days")),
    Y_30d            = as.integer(!is.na(days_to_event) & days_to_event >= 1 & days_to_event <= 30),
    outcome_group    = if_else(Y_30d == 1L, "Event (30d)", "No Event"),
    index_event_type = factor(index_event_type, levels = c("ED","Inpatient"))
  ) %>%
  filter(!is.na(index_event_type))

traj_m2 <- pd_labeled_disp %>%
  group_by(index_event_type, outcome_group, days_post_discharge) %>%
  summarise(
    mean_steps = mean(daily_steps, na.rm = TRUE),
    se_steps   = sd(daily_steps,   na.rm = TRUE) / sqrt(dplyr::n()),
    n_pts      = n_distinct(PatientICN),
    .groups = "drop"
  )

p_traj_m2 <- ggplot(traj_m2 %>% filter(!is.na(mean_steps)),
       aes(x = days_post_discharge, y = mean_steps,
           color = outcome_group, fill = outcome_group)) +
  geom_ribbon(aes(ymin = mean_steps - se_steps, ymax = mean_steps + se_steps),
              alpha = 0.15, color = NA) +
  geom_line(linewidth = 0.7) +
  scale_color_manual(values = c("Event (30d)" = "#d73027", "No Event" = "#69b3a2"),
                     name = "Outcome") +
  scale_fill_manual( values = c("Event (30d)" = "#d73027", "No Event" = "#69b3a2"),
                     name = "Outcome") +
  scale_x_continuous(breaks = seq(0, 90, by = 14)) +
  facet_wrap(~index_event_type, ncol = 2, labeller = label_both) +
  labs(x = "Days post-discharge", y = "Daily steps",
       title = NULL) +
  theme_science() +
  theme(legend.position = "bottom",
        legend.text    = element_text(size = 8),
        legend.title   = element_text(size = 8),
        strip.text     = element_text(face = "bold"))

ggsave(file.path(out_figures, "Figure_3_step_trajectories_postdischarge.png"),
       plot = p_traj_m2, width = 9, height = 5, dpi = 300, bg = "white")
p_traj_m2
```

