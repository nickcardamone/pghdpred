  pg_G5                        = "Priority Group 5 (Group 1)",
  pg_G6                        = "Priority Group 6 (Group 1)",
  pg_G7                        = "Priority Group 7 (Group 1)",
  pg_G8                        = "Priority Group 8 (Group 1)",
  pg_Unknown                   = "Unknown Priority Group (Group 1)",
