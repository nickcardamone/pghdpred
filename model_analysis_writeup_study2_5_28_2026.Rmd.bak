## Figure 4. ROC Curves at Wk04 and AUC Trend by Juncture

```{r fig4-roc-m2, echo=FALSE, fig.height=4.8, fig.cap="Figure 4. ROC curves at 30-day horizon for logistic regression and XGBoost across feature sets (left, center). Right: AUC summary by feature set, horizon (14-day and 30-day), and algorithm."}
roc_30d <- m2_roc_data_30d %>%
  mutate(
    feature_label = recode(feature_mode, !!!feat_labels),
    algo = recode(model_type, logistic = "Logistic", xgboost = "XGBoost")
  )

make_roc_panel <- function(algo_name) {
  d     <- roc_30d %>% filter(algo == algo_name)
  auc_d <- d %>% group_by(feature_label) %>%
    dplyr::slice(round(dplyr::n() / 2)) %>% ungroup()
  ggplot(d, aes(x = fpr, y = tpr, color = feature_label)) +
    geom_line(linewidth = 0.9) +
    geom_abline(slope = 1, intercept = 0, linetype = "dotted", color = "grey60") +
    scale_color_manual(values = feat_colors, name = "Feature set") +
    scale_x_continuous(labels = percent_format(accuracy = 1), limits = c(0, 1)) +
    scale_y_continuous(labels = percent_format(accuracy = 1), limits = c(0, 1)) +
    ggrepel::geom_label_repel(
      data = auc_d,
      aes(label = sprintf("AUC = %.3f", auc_val)),
      size = 2.3, box.padding = 0.25, show.legend = FALSE, segment.size = 0.25
    ) +
    labs(x = "1 - Specificity", y = "Sensitivity", title = algo_name) +
    theme_science() +
    theme(legend.position = "none")
}

p_auc_summary <- m2_summaries %>%
  mutate(
    feature_label = recode(feature_mode, !!!feat_labels),
    algo          = dplyr::recode(model_type, xgboost = "XGBoost", logistic = "Logistic"),
    horizon_label = if_else(horizon == 14L, "14-Day", "30-Day")
  ) %>%
  ggplot(aes(x = feature_label, y = auc,
             color = horizon_label, shape = algo,
             group = interaction(algo, horizon_label))) +
  geom_line(linewidth = 0.6, alpha = 0.8) +
  geom_point(size = 2.5) +
  scale_y_continuous(limits = c(0.50, 0.95)) +
  scale_color_manual(values = c("14-Day" = "#e66101", "30-Day" = "#5e3c99"),
    name = "Horizon") +
  scale_shape_manual(values = c("Logistic" = 16L, "XGBoost" = 17L),
    name = "Algorithm") +
  labs(x = "Feature set", y = "AUC (30% hold-out)",
       title = "AUC by Feature Set & Horizon") +
  theme_science() +
  theme(axis.text.x = element_text(angle = 25, hjust = 1),
        legend.position = "right")

p_fig4 <- make_roc_panel("Logistic") + make_roc_panel("XGBoost") + p_auc_summary +
  plot_layout(ncol = 3, guides = "collect") &
  theme(legend.position = "bottom")

ggsave(file.path(out_figures, "Figure_4_ROC_30d.png"),
       plot = p_fig4, width = 12, height = 4.8, dpi = 300, bg = "white")
p_fig4
```

