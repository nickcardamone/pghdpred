```{r model-fitting-m2, eval = FALSE}
# FIT 12 MODELS: 3 feature sets x 2 horizons x 2 algorithms
# Uses Wk04 snapshot (maximum post-discharge PGHD accumulation).
# Y is computed dynamically so both 14d and 30d horizons share the same features.

junc_wk04 <- open_dataset(file.path(out_output, "junc_all.parquet")) %>%
  filter(juncture == "Wk04") %>% collect()

train_pts_m2 <- open_dataset(file.path(out_output, "train_pts_m2.parquet")) %>%
  collect() %>% pull(PatientICN)
test_pts_m2  <- open_dataset(file.path(out_output, "test_pts_m2.parquet")) %>%
  collect() %>% pull(PatientICN)

fit_m2_one <- function(feature_mode, horizon, model_type,
                       df_in = junc_wk04) {
  message(sprintf("\n[fit_m2_one] %-30s | %2dd | %s", feature_mode, horizon, model_type))

  avail_step   <- intersect(step_cols_m2,       names(df_in))
  avail_static <- intersect(static_cols_m2_all, names(df_in))

  keep_feats <- switch(feature_mode,
    model1_steps_only       = avail_step,
    model2_static_only      = avail_static,
    model3_steps_and_static = union(avail_step, avail_static),
    return(NULL))
  if (length(keep_feats) == 0L) return(NULL)

  model_cols <- c("PatientICN", "days_to_event", keep_feats)

  tr_full <- df_in %>%
    filter(PatientICN %in% train_pts_m2) %>%
    select(all_of(intersect(model_cols, names(df_in)))) %>%
    mutate(Y = calc_y_horizon(days_to_event, horizon)) %>%
    filter(!is.na(Y)) %>%
    select(-days_to_event)
  te <- df_in %>%
    filter(PatientICN %in% test_pts_m2) %>%
    select(all_of(intersect(model_cols, names(df_in)))) %>%
    mutate(Y = calc_y_horizon(days_to_event, horizon)) %>%
    filter(!is.na(Y)) %>%
    select(-PatientICN, -days_to_event) %>%
    as.data.frame()

  if (sum(tr_full$Y) < 5 || sum(te$Y) < 5) return(NULL)

  # 20% patient-level Platt calibration hold-out (carved before undersampling)
  cal_pts    <- sample(unique(tr_full$PatientICN),
                       size = max(1L, floor(0.2 * n_distinct(tr_full$PatientICN))),
                       replace = FALSE)
  tr_fit_raw <- tr_full %>% filter(!PatientICN %in% cal_pts)
  tr_cal_raw <- tr_full %>% filter( PatientICN %in% cal_pts)

  spw_true      <- sum(tr_fit_raw$Y == 0) / max(sum(tr_fit_raw$Y == 1), 1)
  tr_under_full <- undersample_by_patient(tr_fit_raw)
  pat_ids_under <- tr_under_full %>% pull(PatientICN)
  tr_under      <- as.data.frame(tr_under_full %>% select(-PatientICN))
  tr_full_df    <- as.data.frame(tr_fit_raw %>% select(-PatientICN))
  y_te          <- te$Y

  if (model_type == "logistic") {
    rec  <- make_recipe_glmnet(tr_under)
    prp  <- prep(rec, training = tr_under, retain = TRUE)
    trb  <- bake(prp, new_data = tr_under)
    teb  <- bake(prp, new_data = te)
    fit  <- tryCatch(
      suppressWarnings(glm(Y ~ ., data = trb, family = binomial())),
      error = function(e) NULL)
    if (is.null(fit)) { message("  SKIP: glm() failed"); return(NULL) }
    pred_raw  <- predict(fit, newdata = teb, type = "response")
    cal_baked <- bake(prp, new_data = as.data.frame(tr_cal_raw %>% select(-PatientICN)))
    pred_cal  <- predict(fit, newdata = cal_baked, type = "response")
    y_cal     <- as.integer(cal_baked$Y)
    coef_tbl  <- tryCatch({
      vcov_cl <- sandwich::vcovCL(fit, cluster = data.frame(id = pat_ids_under))
      ct      <- lmtest::coeftest(fit, vcov = vcov_cl)
      as.data.frame(ct) %>%
        tibble::rownames_to_column("term") %>% as_tibble() %>%
        rename(estimate = Estimate, std.error = `Std. Error`,
               statistic = `z value`, p.value = `Pr(>|z|)`) %>%
        mutate(odds_ratio   = exp(estimate),
               feature_mode = feature_mode, horizon = as.integer(horizon),
               model_type   = model_type)
    }, error = function(e) {
      broom::tidy(fit) %>%
        mutate(odds_ratio   = exp(estimate),
               feature_mode = feature_mode, horizon = as.integer(horizon),
               model_type   = model_type)
    })
  } else {
    rec   <- make_recipe_xgboost(tr_full_df)
    prp   <- prep(rec, training = tr_full_df, retain = TRUE)
    trb   <- bake(prp, new_data = tr_full_df)
    teb   <- bake(prp, new_data = te)
    y_tr  <- as.numeric(trb$Y)
    x_tr  <- as.matrix(trb %>% select(-Y) %>% mutate(across(everything(), as.numeric)))
    x_te  <- as.matrix(teb %>% select(-Y) %>% mutate(across(everything(), as.numeric)))
    dtrain <- xgboost::xgb.DMatrix(x_tr, label = y_tr)
    dtest  <- xgboost::xgb.DMatrix(x_te, label = y_te)
    fit    <- xgboost::xgb.train(
      params = list(
        objective = "binary:logistic", eval_metric = "auc",
        eta = 0.05, max_depth = 5, min_child_weight = 3,
        subsample = 0.7, colsample_bytree = 0.7,
        scale_pos_weight = spw_true),
      data = dtrain, nrounds = 200L, verbose = 0L,
      watchlist = list(train = dtrain, test = dtest),
      early_stopping_rounds = 15L)
    pred_raw  <- predict(fit, dtest)
    cal_baked <- bake(prp, new_data = as.data.frame(tr_cal_raw %>% select(-PatientICN)))
    x_cal     <- as.matrix(cal_baked %>% select(-Y) %>%
                   mutate(across(everything(), as.numeric)))
    pred_cal  <- predict(fit, xgboost::xgb.DMatrix(x_cal))
    y_cal     <- as.integer(cal_baked$Y)
    imp       <- xgboost::xgb.importance(model = fit)
    coef_tbl  <- tibble(
      term         = imp$Feature,  gain      = imp$Gain,
      cover        = imp$Cover,    frequency = imp$Frequency,
      feature_mode = feature_mode, horizon   = as.integer(horizon),
      model_type   = model_type)
  }

  # Pre-Platt calibration slope
  eps_cal       <- 1e-6
  logit_raw     <- log(pmax(eps_cal, pred_raw) / pmax(eps_cal, 1 - pred_raw))
  cal_slope_raw <- tryCatch(
    coef(suppressWarnings(
      glm(as.integer(y_te) ~ logit_raw, family = binomial())))["logit_raw"],
    error = function(e) NA_real_)

  # Platt scaling on calibration hold-out
  pl   <- tryCatch(
    suppressWarnings(glm(y_cal ~ pred_cal, family = binomial())),
    error = function(e) NULL)
  pred <- if (!is.null(pl))
    predict(pl, newdata = data.frame(pred_cal = pred_raw), type = "response")
  else pred_raw
  m <- compute_global_metrics(as.integer(y_te), pred)
  message(sprintf("  AUC=%.4f  PR-AUC=%.4f  BSS=%.4f  cal_slope=%.3f",
                  m$auc, m$pr_auc, m$bss, m$cal_slope))

  roc_obj <- tryCatch(
    pROC::roc(as.integer(y_te), pred, quiet = TRUE),
    error = function(e) NULL)

  list(
    summary = tibble(
      feature_mode         = feature_mode, horizon = as.integer(horizon),
      model_type           = model_type,
      auc                  = round(m$auc,          4),
      pr_auc               = round(m$pr_auc,        4),
      brier                = round(m$brier,         5),
      bss                  = round(m$bss,           4),
      cal_slope_pre_platt  = round(cal_slope_raw,   4),
      cal_slope_post_platt = round(m$cal_slope,     4),
      n_test               = length(y_te),
      events_test          = sum(as.integer(y_te))),
    roc          = roc_obj,
    pred         = pred,
    y            = as.integer(y_te),
    coef_tbl     = coef_tbl,
    calibration  = make_calibration_table(pred, as.integer(y_te)),
    feature_mode = feature_mode, horizon = as.integer(horizon), model_type = model_type
  )
}

# Run all 12 models
feature_sets <- c("model1_steps_only","model2_static_only","model3_steps_and_static")
horizons     <- c(14L, 30L)
model_types  <- c("logistic","xgboost")

total_fits <- length(feature_sets) * length(horizons) * length(model_types)
fit_count  <- 0L
m2_results <- list()
for (fm in feature_sets) {
  for (hz in horizons) {
    for (mt in model_types) {
      fit_count <- fit_count + 1L
      message(sprintf("\n=== [%d/%d] %s | %dd | %s ===", fit_count, total_fits, fm, hz, mt))
      res <- tryCatch(
        fit_m2_one(fm, hz, mt),
        error = function(e) { message("  ERROR: ", conditionMessage(e)); NULL })
      if (!is.null(res)) m2_results <- append(m2_results, list(res))
    }
  }
}
message(sprintf("model-run complete: %d/%d fitted.", length(m2_results), total_fits))

m2_summaries <- bind_rows(lapply(m2_results, `[[`, "summary"))
writexl::write_xlsx(as.data.frame(m2_summaries),
  file.path(out_data, "Table2_model_performance_m2.xlsx"))
write_parquet(m2_summaries, file.path(out_output, "m2_summaries.parquet"))

# Wide-format table (horizons as columns)
m2_perf_wide <- m2_summaries %>%
  mutate(
    feature_label = recode(feature_mode, !!!feat_labels),
    algo = dplyr::recode(model_type, xgboost = "XGBoost", logistic = "Logistic")) %>%
  select(feature_label, algo, horizon,
         auc, pr_auc, bss, cal_slope_pre_platt, cal_slope_post_platt,
         n_test, events_test) %>%
  pivot_wider(
    names_from  = horizon,
    values_from = c(auc, pr_auc, bss, cal_slope_pre_platt, cal_slope_post_platt,
                    n_test, events_test),
    names_glue  = "{.value}_{horizon}d"
  ) %>%
  arrange(algo, feature_label)
write_parquet(m2_perf_wide, file.path(out_output, "m2_perf_wide.parquet"))

m2_roc_data_30d <- bind_rows(lapply(
  Filter(function(r) !is.null(r$roc) && r$horizon == 30L, m2_results),
  function(r) data.frame(
    fpr          = 1 - r$roc$specificities,
    tpr          = r$roc$sensitivities,
    feature_mode = r$feature_mode,
    model_type   = r$model_type,
    auc_val      = as.numeric(pROC::auc(r$roc)))))
write_parquet(m2_roc_data_30d, file.path(out_output, "m2_roc_data_30d.parquet"))

m2_xgb_importance <- bind_rows(lapply(
  Filter(function(r) r$model_type == "xgboost", m2_results),
  function(r) as.data.frame(r$coef_tbl) %>%
    mutate(horizon = as.integer(r$horizon))))
write_parquet(m2_xgb_importance, file.path(out_output, "m2_xgb_importance.parquet"))

m2_log_coefs <- bind_rows(lapply(
  Filter(function(r) r$model_type == "logistic", m2_results),
  function(r) as.data.frame(r$coef_tbl)))
write_parquet(m2_log_coefs, file.path(out_output, "m2_log_coefs.parquet"))

m2_cal_data <- bind_rows(lapply(m2_results, function(r) {
  if (is.null(r$calibration)) return(NULL)
  r$calibration %>% mutate(
    feature_mode = r$feature_mode, horizon = as.integer(r$horizon),
    model_type   = r$model_type)
}))
write_parquet(m2_cal_data, file.path(out_output, "m2_cal_data.parquet"))
```

```{r sensitivity-run-m2, eval = FALSE}
# Sensitivity: stratify by PGHD data completeness at Wk04.
# clean  : <= 3 missing days (>= 4 days with step data)
# sparse : 4-6 missing days  (1-3 days with step data)

junc_wk04_sa <- open_dataset(file.path(out_output, "junc_all.parquet")) %>%
  filter(juncture == "Wk04") %>% collect()

quality_strata <- junc_wk04_sa %>%
  transmute(
    PatientICN,
    stratum = if_else(!is.na(k_steps_7d_miss_days) & k_steps_7d_miss_days <= 3L,
                      "clean", "sparse"))

sa_results <- list()
for (stratum_nm in c("clean","sparse")) {
  df_s <- junc_wk04_sa %>%
    semi_join(quality_strata %>% filter(stratum == stratum_nm), by = "PatientICN")
  for (hz in horizons) {
    df_hz <- df_s %>%
      mutate(Y = calc_y_horizon(days_to_event, hz)) %>%
      filter(!is.na(Y))
    for (fm in feature_sets) {
      for (mt in model_types) {
        res <- tryCatch({
          avail_step   <- intersect(step_cols_m2,       names(df_hz))
          avail_static <- intersect(static_cols_m2_all, names(df_hz))
          keep_feats <- switch(fm,
            model1_steps_only       = avail_step,
            model2_static_only      = avail_static,
            model3_steps_and_static = union(avail_step, avail_static),
            NULL)
          if (is.null(keep_feats) || length(keep_feats) == 0L) return(NULL)

          tr <- df_hz %>% filter(PatientICN %in% train_pts_m2) %>%
            select(PatientICN, Y, all_of(keep_feats)) %>% filter(!is.na(Y))
          te <- df_hz %>% filter(PatientICN %in% test_pts_m2) %>%
            select(Y, all_of(keep_feats)) %>% filter(!is.na(Y)) %>% as.data.frame()
          if (sum(tr$Y) < 5 || sum(te$Y) < 5) return(NULL)

          tr_df <- as.data.frame(tr %>% select(-PatientICN))
          rec  <- make_recipe_glmnet(tr_df)
          prp  <- prep(rec, training = tr_df, retain = TRUE)
          fit  <- suppressWarnings(glm(Y ~ .,
            data   = bake(prp, new_data = tr_df),
            family = binomial()))
          pred <- predict(fit,
            newdata = bake(prp, new_data = te), type = "response")
          m    <- compute_global_metrics(as.integer(te$Y), pred)

          tibble(stratum = stratum_nm, horizon = as.integer(hz),
                 feature_mode = fm,  model_type = mt,
                 n_test  = length(te$Y),
                 events  = sum(as.integer(te$Y)),
                 auc     = round(m$auc,    4),
                 pr_auc  = round(m$pr_auc, 4),
                 bss     = round(m$bss,    4))
        }, error = function(e) NULL)
        if (!is.null(res)) sa_results <- append(sa_results, list(res))
      }
    }
  }
}

sa_summaries_m2 <- bind_rows(sa_results)
write_parquet(sa_summaries_m2, file.path(out_output, "sa_summaries_m2.parquet"))
writexl::write_xlsx(as.data.frame(sa_summaries_m2),
  file.path(out_data, "Table_SA_sensitivity_m2.xlsx"))
```


