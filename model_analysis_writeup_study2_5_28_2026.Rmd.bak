```{r diag-step5-charts, echo=FALSE, fig.height=4.5, fig.cap="Left: Distribution of weekly_interval_index for removed person-weeks (weeks dropped by censoring). Right: Distribution of days_to_event at the time of removal for event-censored rows (i.e., how far in the future was the event relative to the dropped week?)."}
if (all(file.exists(c("data/output/model2_study2/consort_diag_step4_index.parquet",
                       "data/output/model2_study2/consort_diag_step4_event_days.parquet")))) {
